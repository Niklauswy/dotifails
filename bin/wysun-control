#!/usr/bin/env python3
"""One-shot volume/brightness/media keys from the installed Wysun shell assets."""
import os
from pathlib import Path
import sys
path=Path(__file__).resolve().parent.parent/'share/wysun/quickshell/controls.py'
os.execv('/usr/bin/python3',['/usr/bin/python3','-P',str(path),*sys.argv[1:]])
