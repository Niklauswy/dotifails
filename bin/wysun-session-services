#!/usr/bin/env python3
"""Own only children of this login. No global restarts, kills or service enables."""
import os
from pathlib import Path
import shutil
import signal
import subprocess
import time

children = []
SHELL_COMMAND = ['wysun-shell']
# The shell paints the wallpaper, bar and launcher. If it dies the login is left
# on the bare compositor background, so it is relaunched; a crash loop backs off.
RESTART_WINDOW = 60.0
RESTART_BURST = 5
RESTART_COOLDOWN = 30.0


def log_event(message):
    """Append to the user's state log; never let logging break supervision."""
    try:
        state = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'wysun'
        state.mkdir(parents=True, exist_ok=True)
        with open(state / 'session-services.log', 'a', encoding='utf-8') as handle:
            handle.write(time.strftime('%Y-%m-%d %H:%M:%S ') + message + '\n')
    except OSError:
        pass


def revive_shell(restarts, clock=time.monotonic):
    """Relaunch children[0] (the shell) after it exits; returns True if relaunched."""
    code = children[0].poll()
    if code is None:
        return False
    now = clock()
    restarts[:] = [stamp for stamp in restarts if now - stamp < RESTART_WINDOW]
    if len(restarts) >= RESTART_BURST and now - restarts[-1] < RESTART_COOLDOWN:
        return False
    restarts.append(now)
    detail = f'señal {-code}' if code < 0 else f'código {code}'
    try:
        children[0] = subprocess.Popen(SHELL_COMMAND)
    except OSError as error:
        log_event(f'wysun-shell terminó ({detail}); no se pudo relanzar: {error}')
        return False
    log_event(f'wysun-shell terminó ({detail}); relanzado')
    return True


def stop_children():
    for child in reversed(children):
        if child.poll() is None:
            child.terminate()
    for child in reversed(children):
        try:
            child.wait(timeout=2)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait(timeout=2)
    children.clear()


def stop(*_):
    stop_children()
    raise SystemExit(0)


def main():
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE') or os.environ.get('XDG_SESSION_TYPE') != 'wayland':
        raise SystemExit('Solo se ejecuta dentro de Wysun / Hyprland.')
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    # Import before any Qt/GTK client can activate a portal. Fail before starting
    # clients if the selected login cannot publish its compositor environment.
    variables = ('WAYLAND_DISPLAY', 'DISPLAY', 'HYPRLAND_INSTANCE_SIGNATURE',
                 'XDG_CURRENT_DESKTOP', 'XDG_SESSION_TYPE', 'XDG_SESSION_DESKTOP',
                 'XDG_RUNTIME_DIR', 'XDG_CONFIG_HOME', 'XDG_DATA_HOME', 'XDG_DATA_DIRS')
    subprocess.run(['dbus-update-activation-environment', '--systemd',
                    *(name for name in variables if name in os.environ)], check=True)
    commands = [list(SHELL_COMMAND), ['swayidle', '-w', 'timeout', '600', 'wysun-lock',
                                'before-sleep', 'wysun-lock'], ['wysun', 'daemon']]
    # Both notification/polkit agents are scoped to this newly selected login.
    if shutil.which('dunst'):
        config = Path.home() / '.config/wysun/dunstrc'
        commands.append(['dunst', '--config', str(config)] if config.is_file() else ['dunst'])
    for agent in ('/usr/lib/policykit-1-mate/polkit-mate-authentication-agent-1',
                  '/usr/libexec/polkit-mate-authentication-agent-1'):
        if Path(agent).is_file():
            commands.append([agent]); break
    lock_requested = False
    try:
        for command in commands:
            children.append(subprocess.Popen(command))
        # The idle locker belongs to the login, independently of the UI. A
        # crashed shell is relaunched by revive_shell (or by `wysun recover`); it
        # must never disable the already running inactivity/sleep protection.
        idle = children[1]
        restarts = []
        while idle.poll() is None:
            time.sleep(1)
            revive_shell(restarts)
        # Fail closed if the idle monitor itself dies. This invokes the same
        # checked lock acquisition as the public command, without suspending.
        lock_requested = True
        subprocess.run(['wysun-lock'], check=True)
        raise RuntimeError('El monitor de bloqueo terminó; la sesión se ha bloqueado.')
    except Exception:
        if not lock_requested:
            # A partial startup must not remove the idle protection and leave
            # an unlocked login merely because another client could not start.
            subprocess.run(['wysun-lock'], check=True)
        raise
    finally:
        stop_children()


if __name__ == '__main__':
    main()
