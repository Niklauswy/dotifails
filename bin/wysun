#!/usr/bin/env python3
"""Public Wysun entry point: shell routes go to `wysun-shell`, apps run as `python3 -P -m <paquete>`."""
import os
from pathlib import Path
import subprocess
import sys


SHELL_ROUTES = {
    # Former Qt menus, now served by the shell: command -> wysun-shell arguments.
    'toggle': ['launcher'], 'launcher': ['launcher'],
    'clipboard': ['category', 'clip'], 'emoji': ['emoji'],
    'calculator': ['category', 'calc'], 'power': ['session'],
    'color': ['open', 'colors'], 'color-pick': ['color-pick'],
    'processes': ['open', 'processes'], 'cheatsheet': ['cheatsheet'], 'wallpapers': ['wallpapers'],
    'audio': ['open', 'quicksettings'], 'notifications': ['open', 'notifications'],
    'calendar': ['open', 'dashboard'], 'system': ['open', 'dashboard'],
}


def shell_command(command, args):
    """Run the shell widget for a command that used to be a Qt menu.

    There is no Qt fallback: if the shell does not answer, fail visibly.
    """
    helper = Path(__file__).resolve().parent / 'wysun-shell'
    try:
        result = subprocess.run([str(helper), *SHELL_ROUTES[command], *args], timeout=3,
                                capture_output=True, text=True, check=False)
    except subprocess.TimeoutExpired:
        print('Wysun: el shell no respondió; no hay lanzador alternativo. Comprueba `wysun shell status`.', file=sys.stderr)
        return 1
    except OSError as exc:
        print(f'Wysun: no se pudo contactar con el shell: {exc}', file=sys.stderr)
        return 1
    if result.returncode != 0 or result.stdout.strip() == 'false':
        print('Wysun: el shell rechazó la apertura (¿sin pantalla enfocada o shell caído?). '
              'Prueba `wysun recover`.', file=sys.stderr)
        return 1
    return 0


def app_root():
    """Package root: the installed copy next to ~/.local/bin, else the checkout this script belongs to."""
    here = Path(__file__).resolve().parent
    installed = here.parent / 'share/wysun/app'
    return installed if installed.is_dir() else here.parent / 'apps/python'


def run_module(module, args):
    """Replace this process with ``python3 -P -m module args`` importing from the package root."""
    env = dict(os.environ, PYTHONPATH=str(app_root()))
    os.execve('/usr/bin/python3', ['/usr/bin/python3', '-P', '-m', module, *args], env)


# Settings and the network page use Nexus; Processes has its own shell module.
NEXUS_DEFAULTS = {'settings': 'home', 'network': 'network'}


def open_nexus(command, args):
    """Ask the running shell to show a Nexus page; there is no separate window to fall back to."""
    route = command.removeprefix('settings-') if command.startswith('settings-') else (args[0] if args else NEXUS_DEFAULTS[command])
    helper = Path(__file__).resolve().parent / 'wysun-shell'
    try:
        result = subprocess.run([str(helper), 'nexus', route], timeout=4, capture_output=True, text=True, check=False)
    except (OSError, subprocess.TimeoutExpired):
        print('Wysun: el shell no responde; inicia la sesión Wysun para abrir esta página.', file=sys.stderr)
        return 1
    if result.returncode != 0 or result.stdout.strip() != 'true':
        print('Wysun: página desconocida o shell no disponible: ' + route, file=sys.stderr)
        return 1
    return 0


def main():
    args = sys.argv[1:]
    if args and args[0] in ('--help', '-h', 'help'):
        print('Wysun · aplicaciones del escritorio\n'
              'Uso: wysun [scheme|wallpaper|shell|recover|lock|session-check|doctor|install|audio|calendar|recorder|screenshot|pdf|music|music-mini|files|player|image|settings|processes|colors|color-pick|power|activate CLASE] [opciones]\n'
              'Sin argumentos abre el lanzador. Recorder y Screenshot abren su biblioteca;\n'
              'wysun player [--paused] [--fullscreen] [--start S] [--] ARCHIVO... abre imágenes, video y audio (alias: wysun image);\n'
              'wysun recorder --quick-record abre la barra de preparación sin grabar.\n'
              'El lanzador es el widget inferior del shell; si el shell no responde,\n'
              'falla de forma visible (sin lanzador Qt alternativo).')
        return 0
    command = args.pop(0) if args else 'toggle'
    if command in NEXUS_DEFAULTS or command.startswith('settings-'):
        return open_nexus(command, args)
    command = {'colors': 'color'}.get(command, command)
    modules = {'pdf': 'wysun_pdf', 'scheme': 'wysun_services.scheme', 'wallpaper': 'wysun_services.wallpaper',
               'files': 'wysun_files'}
    if command in modules:
        return run_module(modules[command], args)
    if command in SHELL_ROUTES and (command != 'toggle' or not args):
        return shell_command(command, args)
    if command == 'screenshot':
        return screenshot(args)
    if command == 'activate':
        os.execv(str(Path(__file__).resolve().parent / 'wysun-wm'), ['wysun-wm', 'activate', *args])
    commands = {'doctor': 'wysun-install', 'install': 'wysun-install', 'shell': 'wysun-shell', 'lock': 'wysun-lock', 'recover': 'wysun-recover', 'session-check': 'wysun-session', 'recorder': 'wysun-recorder',
                'tools-cli': 'wysun-tools', 'player': 'wysun-player', 'image': 'wysun-player'}
    if command not in commands:
        # Clipboard resident and the remaining app routes (music, daemon, reload…); the Plan 05 dispatcher replaces it.
        return run_module('wysun_services.client', [command, *args])
    executable = Path(__file__).resolve().parent / commands[command]
    if command == 'session-check':forwarded = ['--check', *args]
    elif command in ('doctor', 'install'):forwarded = [command, *args]
    else:forwarded = args
    os.execv(str(executable), [str(executable), *forwarded])


def screenshot(args):
    """Screenshots live in the shell; translate the options of the former app.

    --accept-on-select or --clipboard keep the quick flow (copy, and save to
    --path, as soon as a region is chosen); otherwise the region offers copy,
    save as, annotate and text.
    """
    forwarded = []
    if '--accept-on-select' not in args and '--clipboard' not in args:
        forwarded.append('--options')
    if '--path' in args:
        index = args.index('--path')
        if index + 1 < len(args):
            forwarded += ['--path', args[index + 1]]
    else:
        forwarded.append('--no-save')
    os.execv(str(Path(__file__).resolve().parent / 'wysun-shell'), ['wysun-shell', 'screenshot', *forwarded])


if __name__ == '__main__':
    raise SystemExit(main())
