#!/usr/bin/env python3
"""Wysun, the single entry point: shell surfaces and actions go to `wysun-shell`, apps run as `python3 -P -m`.

Standard library only and nothing imported from the app, so a shell route costs one IPC call.
"""
import os
from pathlib import Path
import subprocess
import sys

HERE = Path(__file__).resolve().parent
PYTHON = '/usr/bin/python3'

# Shell actions that are not surfaces: command -> wysun-shell arguments. Any other word is a
# surface name, which only the shell knows (`wysun-shell surfaces`).
SHELL_ACTIONS = {'clipboard': ['category', 'clip'], 'calculator': ['category', 'calc'], 'color-pick': ['color-pick']}
# Apps and services: command -> (package root, module, leading arguments).
MODULES = {
    'music': ('app', 'wysun_music', []), 'files': ('app', 'wysun_files', []),
    'player': ('app', 'wysun_player', []), 'scheme': ('app', 'wysun_services.scheme', []),
    'wallpaper': ('app', 'wysun_services.wallpaper', []), 'workspaces': ('app', 'wysun_settings.runtime', ['workspaces']),
    'daemon': ('app', 'wysun_services.daemon', []), 'reload': ('app', 'wysun_services.daemon', ['reload']),
    'lanshare': ('app', 'wysun_lanshare', []), 'processes': ('app', 'wysun_processes', []),
    'cloud': ('app', 'wysun_cloud', []),
}
# Programs of their own next to this one: command -> (executable, leading arguments).
PROGRAMS = {
    'shell': ('wysun-shell', []), 'lock': ('wysun-lock', []), 'recover': ('wysun-recover', []),
    'recorder': ('wysun-recorder', []), 'session-check': ('wysun-session', ['--check']),
    'install': ('wysun-install', ['install']), 'update': ('wysun-install', ['update']), 'doctor': ('wysun-install', ['doctor']),
    'activate': ('wysun-wm', ['activate']),
}
HELP = '''Wysun · escritorio
Uso: wysun [ORDEN] [opciones]

  (sin orden)            abre o cierra el lanzador
  SUPERFICIE             abre o cierra una superficie del shell (lista: wysun-shell surfaces)
  clipboard | calculator el lanzador en esa categoría
  color-pick             cuentagotas: copia el color en HEX
  settings [PÁGINA]      Ajustes en el shell
  music | music-mini     Wysun Music (music-mini: en el widget de media)
  files | player         Files y Wysun Player ([--paused] [--fullscreen] [--start S] [--] ARCHIVO...)
  recorder               ajustes del Recorder (--quick-record: barra de grabación)
  scheme | wallpaper     esquema de color y fondo
  lanshare [RUTA…]       comparte con la red local (--subidas, --clave, --inactivo 2h; --help)
  cloud                  VMs de Google Cloud en la terminal (--estado: para la barra)
  daemon | reload        residente del portapapeles; reload lo reinicia con el código nuevo
  shell ORDEN            wysun-shell (record, screenshot, dnd, status…)
  lock | recover | session-check | workspaces | activate CLASE
  update [--check]       git pull del repositorio de este equipo y aplica los cambios
  install | doctor       instalador (wysun-install)

Si el shell no responde, falla de forma visible: no hay ventanas alternativas.'''


def root(kind):
    """Package root: the installed copy next to ~/.local/bin, else the checkout this script belongs to."""
    installed = HERE.parent / 'share/wysun' / kind
    return installed if installed.is_dir() else HERE.parent / 'apps/python'


def module_argv(module, args):
    return [PYTHON, '-P', '-m', module, *args]


def module_env(kind):
    return dict(os.environ, PYTHONPATH=str(root(kind)))


def run_module(kind, module, args):
    """Replace this process with ``python3 -P -m module args`` importing from the package root."""
    os.execve(PYTHON, module_argv(module, args), module_env(kind))


def shell(args, timeout=4):
    """Ask the running shell; there is no Qt window to fall back to, so a failure is reported."""
    try:
        result = subprocess.run([str(HERE / 'wysun-shell'), *args], timeout=timeout,
                                capture_output=True, text=True, check=False)
    except subprocess.TimeoutExpired:
        print('Wysun: el shell no respondió. Comprueba `wysun shell status` o prueba `wysun recover`.', file=sys.stderr)
        return 1
    except OSError as exc:
        print(f'Wysun: no se pudo contactar con el shell: {exc}', file=sys.stderr)
        return 1
    if result.returncode != 0 or result.stdout.strip() == 'false':
        print(result.stderr.strip() or f'Wysun: el shell rechazó «{" ".join(args)}» (¿sin pantalla enfocada o shell caído?). '
              'Prueba `wysun recover`.', file=sys.stderr)
        return 1
    return 0


def music_mini():
    """Wysun Music in the shell's media widget: start the app hidden if needed, then show the widget."""
    subprocess.Popen(module_argv('wysun_music', ['--background']), env=module_env('app'), start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    helper = str(HERE / 'wysun-shell')
    os.execv(helper, [helper, 'media', 'Wysun Music'])


def main():
    args = sys.argv[1:]
    if args and args[0] in ('--help', '-h', 'help'):
        print(HELP)
        return 0
    command = args.pop(0) if args else 'launcher'
    if command in MODULES:
        kind, module, leading = MODULES[command]
        return run_module(kind, module, [*leading, *args])
    if command in PROGRAMS:
        program, leading = PROGRAMS[command]
        executable = str(HERE / program)
        try:
            os.execv(executable, [executable, *leading, *args])
        except OSError as exc:
            print(f'Wysun: no se pudo ejecutar {program} ({exc.strerror}). ¿Está instalado? Prueba `wysun update` o `./instalar.sh`.', file=sys.stderr)
            return 127
        return 0
    if command == 'music-mini':
        return music_mini()
    if command == 'settings':
        return shell(['nexus', args[0] if args else 'home'])
    if command in SHELL_ACTIONS:
        return shell(SHELL_ACTIONS[command])
    if args or command.startswith('-'):
        print(f'Wysun: orden desconocida o con argumentos: {" ".join([command, *args])}. Consulta `wysun --help`.', file=sys.stderr)
        return 2
    # Any other word is a surface; only the shell knows the list and answers false to a name it lacks.
    return shell(['toggle', command])


if __name__ == '__main__':
    raise SystemExit(main())
