#!/usr/bin/env python3
"""Wysun recovery: give the desktop back without restarting the session.

Closes whatever may be covering the screen (capture selection overlays, the
shell's area picker and panels) and relaunches the shell when it is not
running. Capture recovery is cooperative and scoped to this compositor; it
preserves annotations and leaves libraries, clipboard owners and Recorder alone.
Bound to Super+Escape (followed by a Hyprland reload) and Super+Ctrl+Alt+Escape in hyprland.lua; also `wysun recover`.
"""
from pathlib import Path
import subprocess
import sys
import time

def run(command, timeout=3):
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def close_capture_overlays():
    helper = Path(__file__).resolve().parent / 'wysun-screenshot'
    result = run([str(helper), '--cancel-selection'], timeout=5)
    if result is not None and result.stdout:
        print(result.stdout.strip())
    return result is not None and result.returncode == 0


def close_shell_overlays():
    here = Path(__file__).resolve().parent
    helper = here / 'wysun-shell'
    if not helper.is_file():
        return
    panels = run([str(helper), 'close'])
    # The area picker holds exclusive keyboard focus on every output.
    picker = run([str(helper), 'picker', 'close'])
    return all(result is not None and result.returncode == 0 for result in (panels, picker))


def start_shell():
    helper = Path(__file__).resolve().parent / 'wysun-shell'
    if not helper.is_file():
        return False
    try:
        subprocess.Popen([str(helper)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return False
    return True


def main(argv):
    if argv and argv[0] in ('-h', '--help'):
        print(__doc__.strip())
        return 0
    capture_ok = close_capture_overlays()
    helper = Path(__file__).resolve().parent / 'wysun-shell'
    status = run([str(helper), 'status'])
    started = False
    overlays_ok = True
    if status is not None and status.returncode == 0:
        overlays_ok = close_shell_overlays()
    else:
        started = start_shell()
        time.sleep(0.5)
    if started:
        status = run([str(helper), 'status'])
    shell_ok = status is not None and status.returncode == 0
    print('Wysun recover: shell ' + ('activo' if shell_ok else 'sin respuesta'))
    return 0 if capture_ok and shell_ok and overlays_ok else 1


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
