#!/bin/sh
# swaylock -f returns successfully only after acquiring the session lock.
set -eu
if [ "${XDG_SESSION_TYPE:-}" != wayland ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    printf '%s\n' 'Wysun Lock requiere una sesión Wayland.' >&2
    exit 1
fi
# The theme's canvas colour (six hex digits) is passed by Wysun; anything else is ignored.
color=121820
case "${WYSUN_LOCK_COLOR:-}" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) color="$WYSUN_LOCK_COLOR" ;;
esac
case "${1:-}" in
    '') exec swaylock --daemonize --color "$color" ;;
    --suspend) swaylock --daemonize --color "$color" && exec systemctl suspend ;;
    *) printf '%s\n' 'Uso: wysun-lock [--suspend]' >&2; exit 2 ;;
esac
