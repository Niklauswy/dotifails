#!/bin/sh
# Wysun lock entry point. `swaylock -f` (daemonized) returns successfully only
# after acquiring the session lock; the opt-in QML backend uses
# WlSessionLock/ext-session-lock-v1 and writes a readiness marker only when the
# compositor has confirmed the lock. If that client fails before confirmation,
# this script falls back to swaylock instead of claiming a false lock.
# Derivado de caelestia-dots/shell (GPL-3.0), modificado para Wysun.
# Presentación visual de modules/lock/Center.qml y center/{PasswordInput,StateMessage}.qml
# en 507d66285e9d9fde9330adc64159cfdebb28c19a; no su backend PAM/lock/IPC.
# Véanse THIRD_PARTY.md y LICENSES/GPL-3.0.txt.
set -eu
if [ "${XDG_SESSION_TYPE:-}" != wayland ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    printf '%s\n' 'Wysun Lock requiere una sesión Wayland.' >&2
    exit 1
fi
suspend=false
preview=false
case "$#" in
    0) ;;
    1)
        case "$1" in
            --suspend) suspend=true ;;
            --preview) preview=true ;;
            *) printf '%s\n' 'Uso: wysun-lock [--suspend | --preview]' >&2; exit 2 ;;
        esac
        ;;
    *) printf '%s\n' 'Uso: wysun-lock [--suspend | --preview]' >&2; exit 2 ;;
esac

# Backend. The Wysun lock (QML, ext-session-lock-v1) is the default; swaylock remains selectable and
# is the fallback whenever the QML lock cannot confirm the lock. Invalid values select the default.
config="${XDG_CONFIG_HOME:-$HOME/.config}/orbit/lock.json"
backend=${WYSUN_LOCK_BACKEND:-}
media=${WYSUN_LOCK_MEDIA:-}
if [ -r "$config" ]; then
    if [ -z "$backend" ]; then
        backend=$(sed -n 's/.*"backend"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' "$config" | head -n 1)
    fi
    if [ -z "$media" ]; then
        media=$(sed -n 's/.*"media"[[:space:]]*:[[:space:]]*true.*/1/p' "$config" | head -n 1)
    fi
fi
backend=${backend:-qml}
case "$media" in 1) ;; *) media=0 ;; esac
case "$backend" in
    swaylock|qml) ;;
    *) printf '%s\n' 'Wysun Lock: backend desconocido; se usa el bloqueo de Wysun.' >&2; backend=qml ;;
esac

# Accept only six hex digits. Standalone key/idle invocations retain swaylock's
# own defaults until Qt supplies the selected Material/preset presentation.
color=121820 # theme-exception: opaque recovery canvas when invoked without Qt tokens
case "${WYSUN_LOCK_COLOR:-}" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) color="$WYSUN_LOCK_COLOR" ;;
esac

run_swaylock() {
    # Ignore any implicit swaylock config: the default lock exposes no image,
    # screenshot, identity, metadata or media controls. No idle animation.
    set -- --config /dev/null --daemonize --color "$color" --font Rubik --hide-keyboard-layout --indicator-caps-lock
    for role in SURFACE ACCENT TEXT MUTED DANGER; do
        case "$role" in
            SURFACE) value=${WYSUN_LOCK_SURFACE:-} ;;
            ACCENT) value=${WYSUN_LOCK_ACCENT:-} ;;
            TEXT) value=${WYSUN_LOCK_TEXT:-} ;;
            MUTED) value=${WYSUN_LOCK_MUTED:-} ;;
            DANGER) value=${WYSUN_LOCK_DANGER:-} ;;
        esac
        case "$value" in
            [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
            *) continue ;;
        esac
        case "$role" in
            SURFACE) set -- "$@" --inside-color "$value" --inside-clear-color "$value" --inside-ver-color "$value" --inside-wrong-color "$value" ;;
            ACCENT) set -- "$@" --ring-color "$value" --ring-ver-color "$value" --key-hl-color "$value" ;;
            TEXT) set -- "$@" --text-color "$value" --text-ver-color "$value" ;;
            MUTED) set -- "$@" --ring-clear-color "$value" --text-clear-color "$value" --separator-color "$value" ;;
            DANGER) set -- "$@" --ring-wrong-color "$value" --text-wrong-color "$value" --bs-hl-color "$value" ;;
        esac
    done
    for metric in RADIUS THICKNESS FONT_SIZE; do
        case "$metric" in
            RADIUS) value=${WYSUN_LOCK_RADIUS:-} ;;
            THICKNESS) value=${WYSUN_LOCK_THICKNESS:-} ;;
            FONT_SIZE) value=${WYSUN_LOCK_FONT_SIZE:-} ;;
        esac
        case "$value" in
            ''|*[!0-9]*) continue ;;
        esac
        # Bound values before passing them to the backend (also reject long integers).
        [ "${#value}" -le 3 ] && [ "$value" -ge 1 ] && [ "$value" -le 256 ] || continue
        case "$metric" in
            RADIUS) set -- "$@" --indicator-radius "$value" ;;
            THICKNESS) set -- "$@" --indicator-thickness "$value" ;;
            FONT_SIZE) set -- "$@" --font-size "$value" ;;
        esac
    done
    if "$suspend"; then
        swaylock "$@" && exec systemctl suspend
    else
        exec swaylock "$@"
    fi
}

shell_root=${WYSUN_SHELL_ROOT:-}
if [ -z "$shell_root" ]; then
    script_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
    if [ -f "$script_root/apps/shell/lock.qml" ]; then
        shell_root="$script_root/apps/shell"
    else
        shell_root="${XDG_DATA_HOME:-$HOME/.local/share}/wysun/quickshell"
    fi
fi
qml="$shell_root/lock.qml"
runtime=${WYSUN_RUNTIME:-${XDG_DATA_HOME:-$HOME/.local/share}/wysun/runtime}
launcher="$shell_root/wysun/runtime.sh"

# Compile the lock's GLSL with the runtime's qsb once per shader revision. The cache is keyed by the
# sources' content; a failure only means the flat presentation (the lock itself never depends on it).
prepare_shaders() {
    sources="$shell_root/modules/lockscreen/shaders"
    [ -d "$sources" ] || return 0
    qsb=
    for candidate in "$runtime"/qt/*/gcc_64/bin/qsb; do
        [ -x "$candidate" ] && qsb=$candidate && break
    done
    [ -n "$qsb" ] || return 0
    key=$(cat "$sources"/*.frag 2>/dev/null | sha256sum | cut -c1-16) || return 0
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/wysun/lock-shaders/$key"
    if [ ! -d "$cache" ]; then
        mkdir -p "${cache%/*}" || return 0
        work=$(mktemp -d "${cache%/*}/.build.XXXXXX") || return 0
        for shader in "$sources"/*.frag; do
            if ! "$qsb" --glsl "300es,330" -o "$work/${shader##*/}.qsb" "$shader" >/dev/null 2>&1; then
                rm -rf "$work"
                return 0
            fi
        done
        mv "$work" "$cache" 2>/dev/null || rm -rf "$work"
    fi
    [ -d "$cache" ] && printf '%s' "$cache"
}

qml_available() {
    [ -f "$1" ] && [ -f "$launcher" ] && [ -x "$runtime/quickshell/bin/quickshell" ]
}

if "$preview"; then
    # Never locks, never authenticates, never falls back to swaylock.
    entry="$shell_root/lock-preview.qml"
    if ! qml_available "$entry"; then
        printf '%s\n' 'Wysun Lock: la vista previa necesita el runtime del shell de Wysun.' >&2
        exit 1
    fi
    WYSUN_LOCK_SHADERS=$(prepare_shaders) WYSUN_SHELL_ENTRY="$entry" exec sh "$launcher"
fi

run_qml() {
    if ! qml_available "$qml"; then
        printf '%s\n' 'Wysun Lock: el bloqueo de Wysun no está instalado; se usa swaylock.' >&2
        run_swaylock
    fi
    shaders=$(prepare_shaders)
    tmp=${XDG_RUNTIME_DIR:-}
    if [ -z "$tmp" ] || [ ! -d "$tmp" ]; then tmp=${TMPDIR:-/tmp}; fi
    ready=$(mktemp "$tmp/wysun-lock-ready.XXXXXX") || {
        printf '%s\n' 'Wysun Lock: no hay un directorio temporal seguro; se usa swaylock.' >&2
        run_swaylock
    }
    trap 'rm -f "$ready"' EXIT HUP INT TERM
    # The scene goes on the monitor in use; the other monitors stay dark.
    output=${WYSUN_LOCK_OUTPUT:-}
    if [ -z "$output" ] && command -v hyprctl >/dev/null 2>&1; then
        output=$(hyprctl -j activeworkspace 2>/dev/null | sed -n 's/.*"monitor": *"\([^"]*\)".*/\1/p' | head -n 1)
    fi
    # A snapshot of that monitor, kept only in the private runtime dir, for the doors to open on.
    desktop=""
    if [ -n "$output" ] && [ "$tmp" = "${XDG_RUNTIME_DIR:-}" ] && command -v grim >/dev/null 2>&1; then
        desktop="$tmp/wysun-lock-desktop.png"
        (umask 077; grim -l 0 -o "$output" "$desktop") 2>/dev/null || desktop=""
    fi
    WYSUN_LOCK_DESKTOP="$desktop" WYSUN_LOCK_OUTPUT="$output" \
    WYSUN_SHELL_ROOT="$shell_root" WYSUN_LOCK_READY="$ready" WYSUN_LOCK_MEDIA="$media" \
        WYSUN_LOCK_SHADERS="$shaders" WYSUN_SHELL_ENTRY="$qml" \
        sh "$launcher" >/dev/null 2>&1 &
    pid=$!
    # Seconds to wait for the compositor to confirm the lock (1-60, default 30).
    limit=30
    case "${WYSUN_LOCK_WAIT:-}" in
        [1-9]|[1-5][0-9]|60) limit=$WYSUN_LOCK_WAIT ;;
    esac
    limit=$((limit * 10))
    tries=0
    while [ ! -s "$ready" ] && kill -0 "$pid" 2>/dev/null && [ "$tries" -lt "$limit" ]; do
        sleep 0.1
        tries=$((tries + 1))
    done
    if [ -s "$ready" ]; then
        rm -f "$ready"
        trap - EXIT HUP INT TERM
        if "$suspend"; then
            systemctl suspend
        fi
        exit 0
    fi
    if kill -0 "$pid" 2>/dev/null; then
        printf '%s\n' 'Wysun Lock: el cliente QML no confirmó el bloqueo a tiempo; puede seguir bloqueando. No se lanza swaylock encima.' >&2
        rm -f "$ready"
        exit 1
    fi
    wait "$pid" 2>/dev/null || true
    rm -f "$ready"
    printf '%s\n' 'Wysun Lock: el bloqueo QML falló antes de confirmar; se usa swaylock.' >&2
    trap - EXIT HUP INT TERM
    run_swaylock
}

if [ "$backend" = qml ]; then
    run_qml
else
    run_swaylock
fi
