#!/usr/bin/env python3
"""Wysun idle manager: lock / display-off timers and lock-before-sleep.

`wysun-idle run` is the long-lived child of wysun-session-services. It owns a
swayidle process built from ~/.config/orbit/idle.json and rebuilds it whenever
that file changes, so Settings applies new timers live without touching the
session. If swayidle dies unexpectedly this process exits non-zero and the
session supervisor locks the screen (fail closed).

  wysun-idle run            supervise swayidle (session service)
  wysun-idle get            print the effective preferences as JSON
  wysun-idle set KEY VALUE  update one preference and make sure `run` is alive
  wysun-idle ensure         start a detached `run` when none is running

Keys: lock_minutes, display_off_minutes (0 = never; 1 5 10 15 30 60),
lock_before_sleep (true/false).
"""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

MINUTES = (0, 1, 5, 10, 15, 30, 60)
DEFAULTS = {'lock_minutes': 0, 'display_off_minutes': 0, 'lock_before_sleep': True}
# Hyprland 0.55 dispatches through its Lua API; older releases take `dpms <state>`.
DPMS = "hyprctl dispatch 'hl.dsp.dpms({{action=\"{0}\"}})' || hyprctl dispatch dpms {0}"
# Session started before wysun-idle existed: swayidle was launched directly.
LEGACY = [b'swayidle', b'-w', b'timeout', b'600', b'wysun-lock', b'before-sleep', b'wysun-lock']


def config_path():
    base = os.environ.get('XDG_CONFIG_HOME') or str(Path.home() / '.config')
    return Path(base) / 'orbit' / 'idle.json'


def pid_path():
    runtime = os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir()
    return Path(runtime) / 'wysun-idle.pid'


def load():
    """Effective preferences; anything invalid falls back to the default."""
    result = dict(DEFAULTS)
    try:
        data = json.loads(config_path().read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return result
    if not isinstance(data, dict):
        return result
    for key in ('lock_minutes', 'display_off_minutes'):
        value = data.get(key)
        if isinstance(value, int) and not isinstance(value, bool) and value in MINUTES:
            result[key] = value
    if isinstance(data.get('lock_before_sleep'), bool):
        result['lock_before_sleep'] = data['lock_before_sleep']
    return result


def save(prefs):
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.tmp')
    temporary.write_text(json.dumps(prefs, indent=2) + '\n', encoding='utf-8')
    os.replace(temporary, path)


def swayidle_arguments(prefs):
    """swayidle argv for the preferences, or None when nothing needs watching."""
    argv = ['swayidle', '-w']
    if prefs['lock_minutes']:
        argv += ['timeout', str(prefs['lock_minutes'] * 60), 'wysun-lock']
    if prefs['display_off_minutes']:
        argv += ['timeout', str(prefs['display_off_minutes'] * 60),
                 DPMS.format('off'), 'resume', DPMS.format('on')]
    if prefs['lock_before_sleep']:
        argv += ['before-sleep', 'wysun-lock']
    return argv if len(argv) > 2 else None


def process_arguments(pid):
    try:
        raw = Path(f'/proc/{pid}/cmdline').read_bytes()
    except OSError:
        return []
    return raw.rstrip(b'\0').split(b'\0')


def running_daemon():
    try:
        pid = int(pid_path().read_text().strip())
    except (OSError, ValueError):
        return None
    arguments = process_arguments(pid)
    if any(item.endswith(b'wysun-idle') for item in arguments) and b'run' in arguments:
        return pid
    return None


def own_processes():
    for entry in Path('/proc').iterdir():
        if entry.name.isdecimal():
            try:
                if entry.stat().st_uid == os.getuid():
                    yield int(entry.name)
            except OSError:
                continue


def signal_legacy(sig):
    """Pause/resume the swayidle of a session that predates this manager."""
    if os.environ.get('WYSUN_IDLE_LEGACY') == '0':
        return
    for pid in own_processes():
        if process_arguments(pid) == LEGACY:
            try:
                os.kill(pid, sig)
            except OSError:
                pass


def stop(child):
    if child and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait(timeout=3)


def run():
    previous = running_daemon()
    if previous and previous != os.getpid():
        os.kill(previous, signal.SIGTERM)
        time.sleep(0.5)
    pid_path().write_text(str(os.getpid()))
    state = {'child': None}

    def finish(*_):
        stop(state['child'])
        signal_legacy(signal.SIGCONT)
        raise SystemExit(0)

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, finish)
    signal_legacy(signal.SIGSTOP)
    active = None
    try:
        while True:
            argv = swayidle_arguments(load())
            if argv != active:
                stop(state['child'])
                state['child'] = None
                if argv:
                    state['child'] = subprocess.Popen(argv)
                active = argv
            elif state['child'] is not None and state['child'].poll() is not None:
                # Lost the idle monitor: leave non-zero so the session fails closed.
                raise SystemExit(1)
            time.sleep(1)
    finally:
        stop(state['child'])


def ensure():
    if running_daemon():
        return
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'run'], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def parse_value(key, text):
    if key == 'lock_before_sleep':
        if text not in ('true', 'false'):
            raise ValueError('lock_before_sleep must be true or false')
        return text == 'true'
    if not text.isdecimal() or int(text) not in MINUTES:
        raise ValueError(f'{key} must be one of {", ".join(map(str, MINUTES))}')
    return int(text)


def main(argv):
    command = argv[0] if argv else ''
    if command == 'run':
        run()
    elif command == 'get':
        print(json.dumps(load()))
    elif command == 'ensure':
        ensure()
    elif command == 'set' and len(argv) == 3 and argv[1] in DEFAULTS:
        try:
            prefs = load()
            prefs[argv[1]] = parse_value(argv[1], argv[2])
            save(prefs)
        except (OSError, ValueError) as error:
            print(f'wysun-idle: {error}', file=sys.stderr)
            return 1
        ensure()
        print(json.dumps(prefs))
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
