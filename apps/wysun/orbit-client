#!/usr/bin/env python3
import os, socket, subprocess, sys
from pathlib import Path
endpoint=str(Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/f'orbit-{os.getuid()}.sock')
mode=sys.argv[1] if len(sys.argv)>1 else 'toggle'
if mode in ('files', 'file-manager'):
    state=Path.home()/'.local/state';state.mkdir(parents=True,exist_ok=True)
    with (state/'orbit-files.log').open('a') as log:
        subprocess.Popen(['/usr/bin/python3', str(Path(__file__).resolve().with_name('files_app.py'))] + sys.argv[2:], stdout=log, stderr=log, start_new_session=True)
    sys.exit(0)
if mode in ('music','music-mini'):
    music_endpoint=str(Path(os.environ.get('XDG_RUNTIME_DIR',str(Path.home()/'.cache/orbit')))/f'orbit-music-app-{os.getuid()}.sock')
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(.3);s.connect(music_endpoint);s.sendall((('mini' if mode=='music-mini' else 'present')+'\n').encode())
    except OSError:
        state=Path.home()/'.local/state';state.mkdir(parents=True,exist_ok=True)
        with (state/'orbit-music.log').open('a') as log:
            subprocess.Popen(['/usr/bin/python3',str(Path(__file__).resolve().with_name('music_app.py'))]+(['--mini'] if mode=='music-mini' else []),stdout=log,stderr=log,start_new_session=True)
    sys.exit(0)
if mode in ('settings','network') or mode.startswith('settings-'):
    # These pages are shell widgets (Nexus); `wysun` asks the running shell to open them.
    wysun=Path.home()/'.local/bin/wysun'
    os.execv(str(wysun),[str(wysun),mode]+sys.argv[2:])
try:
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(.3);s.connect(endpoint);s.sendall((mode+'\n').encode())
except OSError:
    state=Path.home()/'.local/state';state.mkdir(parents=True,exist_ok=True)
    with (state/'orbit.log').open('a') as log:
        start_mode='daemon' if mode=='reload' else mode
        subprocess.Popen(['/usr/bin/python3',str(Path(__file__).resolve().with_name('orbit.py')),start_mode]+(['--daemon'] if start_mode=='daemon' else []),stdout=log,stderr=log,start_new_session=True)
