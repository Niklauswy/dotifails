[global]
follow = mouse
width = (300, 380)
height = (0, 220)
origin = top-right
offset = (20, 58)
notification_limit = 4
font = Inter 10
format = "<b>%s</b>\n%b"
padding = 18
horizontal_padding = 20
text_icon_padding = 14
frame_width = 1
frame_color = "#45434F"
separator_height = 1
separator_color = frame
corner_radius = 12
transparency = 5
gap_size = 10
icon_theme = "Fluent-dark, Adwaita, hicolor"
icon_position = left
min_icon_size = 24
max_icon_size = 40
progress_bar = true
progress_bar_height = 4
progress_bar_frame_width = 0
progress_bar_min_width = 150
progress_bar_max_width = 300
highlight = "#C4B5E7"
word_wrap = yes
ellipsize = end
markup = full
show_age_threshold = 60
history_length = 30
stack_duplicates = true
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#19191F"
foreground = "#BBBBCA"
timeout = 4

[urgency_normal]
background = "#19191F"
foreground = "#EEEEF2"
timeout = 6

[urgency_critical]
background = "#241B22"
foreground = "#FFD9E1"
frame_color = "#CB7A92"
timeout = 0
