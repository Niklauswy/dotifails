#!/usr/bin/env python3
import os, socket, subprocess, sys
from pathlib import Path
endpoint=str(Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/f'orbit-{os.getuid()}.sock')
mode=sys.argv[1] if len(sys.argv)>1 else 'toggle'
if mode=='settings' or mode.startswith('settings-'):
    page=mode.removeprefix('settings-') if mode.startswith('settings-') else (sys.argv[2] if len(sys.argv)>2 else 'home')
    settings_endpoint=str(Path(os.environ.get('XDG_RUNTIME_DIR',str(Path.home()/'.cache/orbit')))/f'orbit-settings-{os.getuid()}.sock')
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(.3);s.connect(settings_endpoint);s.sendall((page+'\n').encode())
    except OSError:
        state=Path.home()/'.local/state';state.mkdir(parents=True,exist_ok=True)
        with (state/'orbit-settings.log').open('a') as log:
            subprocess.Popen(['/usr/bin/python3',str(Path(__file__).resolve().with_name('settings_app.py')),page],stdout=log,stderr=log,start_new_session=True)
    sys.exit(0)
try:
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(.3);s.connect(endpoint);s.sendall((mode+'\n').encode())
except OSError:
    state=Path.home()/'.local/state';state.mkdir(parents=True,exist_ok=True)
    with (state/'orbit.log').open('a') as log:
        subprocess.Popen(['/usr/bin/python3',str(Path(__file__).resolve().with_name('orbit.py')),mode]+(['--daemon'] if mode=='daemon' else []),stdout=log,stderr=log,start_new_session=True)
