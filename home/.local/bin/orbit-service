#!/usr/bin/env python3
import os, sys
from pathlib import Path
sys.path.insert(0,str(Path(os.environ.get('XDG_DATA_HOME',str(Path.home()/'.local/share')))/'orbit/app'))
from service_runtime import Services
services=Services();name=sys.argv[1]
if sys.argv[2:]==['--stop']:services.stop(name)
else:services.start(name,sys.argv[2:])
