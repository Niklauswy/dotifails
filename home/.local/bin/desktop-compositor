#!/usr/bin/env python3
import os,sys
from pathlib import Path
sys.path.insert(0,str(Path(os.environ.get('XDG_DATA_HOME',str(Path.home()/'.local/share')))/'orbit/app'))
from service_runtime import Services
s=Services()
if len(sys.argv)>1 and sys.argv[1]=='toggle' and s.running('picom'):
    s.stop('picom')
else:
    s.start('picom',['picom','--config',str(Path(os.environ.get('XDG_CONFIG_HOME',str(Path.home()/'.config')))/'bspwm/picom.conf')])
