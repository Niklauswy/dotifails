#!/bin/sh
# Reuse Ghostty for an empty window; preserve argv when opening an editor/command.
if [ "$#" -eq 0 ] && gdbus call --session --dest com.mitchellh.ghostty \
    --object-path /com/mitchellh/ghostty --method org.gtk.Actions.Activate \
    new-window '[]' '{}' >/dev/null 2>&1; then
    exit 0
fi
exec ghostty "$@"
