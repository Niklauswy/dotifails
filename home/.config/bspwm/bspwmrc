#!/bin/sh
export PATH="$HOME/.local/bin:$PATH"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
state="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state/dotifails"
desktop-displays >>"$state/dotifails/displays.log" 2>&1
bspc config border_width 1
bspc config window_gap 12
bspc config split_ratio 0.50
bspc config focused_border_color '#7aa2f7'
bspc config normal_border_color '#24283b'
bspc config active_border_color '#565f89'
bspc config presel_feedback_color '#bb9af7'
for setting in borderless_monocle gapless_monocle paddingless_monocle; do bspc config "$setting" true; done
bspc config single_monocle false
bspc config focus_follows_pointer true
bspc rule -a Orbit state=floating center=true border=off
bspc rule -a flameshot state=floating center=true border=off
orbit-service sxhkd sxhkd -c "$config/sxhkd/sxhkdrc"
orbit-service dunst dunst -config "$config/bspwm/dunstrc"
orbit-service xsettingsd xsettingsd -c "$config/xsettingsd/xsettingsd.conf"
orbit-service power xfce4-power-manager
orbit-service lock xss-lock --transfer-sleep-lock -- i3lock --nofork -c 11111b
for agent in /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do
    if [ -x "$agent" ]; then orbit-service polkit "$agent"; break; fi
done
xsetroot -cursor_name left_ptr
feh --no-fehbg --bg-fill "$data/backgrounds/tokyo.png"
desktop-compositor
[ ! -f "$config/orbit/bspwm-settings.sh" ] || . "$config/orbit/bspwm-settings.sh"
[ ! -f "$config/dotifails/machine.sh" ] || . "$config/dotifails/machine.sh"
orbit-bar
orbit daemon
/usr/bin/python3 "$data/orbit/app/settings_runtime.py" restore >>"$state/dotifails/settings.log" 2>&1 &
