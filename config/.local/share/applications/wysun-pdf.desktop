[Desktop Entry]
Type=Application
Name=Wysun PDF
Comment=Read and annotate local PDF documents
Comment[es]=Lee y anota documentos PDF locales
Exec=wysun pdf %F
Icon=application-pdf
Terminal=false
Categories=Office;Viewer;
Keywords=pdf;documento;lector;anotar;resaltar;document;reader;annotate;
MimeType=application/pdf;
StartupNotify=true
StartupWMClass=wysun-pdf
